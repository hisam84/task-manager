DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
ENABLE_DEMO_SWITCH="false"

# SMTP Configuration (Brevo, SendGrid, etc.)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-login@smtp-brevo.com"
SMTP_PASS="your-smtp-key"
SMTP_FROM='"Task Manager" <noreply@yourdomain.com>'
NEXT_PUBLIC_APP_URL="http://localhost:3000"
