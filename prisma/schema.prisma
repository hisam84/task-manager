generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive           Boolean   @default(true)
  enableLatePenalty  Boolean   @default(false)
  subscriptionEndsAt DateTime?

  // Company Settings
  overdueAlertRecipient       String   @default("BOTH") // "BOTH" (Assignee & Assigner) or "ASSIGNEE_ONLY"
  notifyAssignerOnTaskComplete Boolean  @default(true)
  enableTaskCreatedEmail       Boolean  @default(true)
  allowEmployeeTaskAssignment  Boolean  @default(true)
  defaultGraceMinutes         Int      @default(15)
  notifyAdminsOnLeaveRequest  Boolean  @default(true)

  createdAt          DateTime  @default(now())

  users       User[]
  tasks       Task[]
  departments Department[]
  shifts      Shift[]
  holidays    Holiday[]
  attendances Attendance[]
  leaveRequests LeaveRequest[]
  activityLogs ActivityLog[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  users User[]
  tasks Task[]

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String
  role         String   @default("EMPLOYEE") // SUPER_ADMIN, ADMIN, MANAGER, EMPLOYEE
  avatar       String?  @db.Text
  designation  String?
  department   String?
  phone        String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  departmentId    String?
  departmentRel  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  assignedTasks Task[]       @relation("AssignedTo")
  taskAssignments TaskAssignee[] @relation("UserTaskAssignees")
  createdTasks  Task[]       @relation("CreatedBy")
  comments      Comment[]
  attendances   Attendance[]
  leaveRequests LeaveRequest[] @relation("Applicant")
  reviewedLeaves LeaveRequest[] @relation("Reviewer")
  activityLogs  ActivityLog[]

  @@index([companyId])
  @@index([departmentId])
  @@index([shiftId])
  @@index([companyId, order])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  overdueNotifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  departmentId    String?
  departmentRel  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assigneeId String
  assignee   User   @relation("AssignedTo", fields: [assigneeId], references: [id])
  assignees  TaskAssignee[]

  creatorId String
  creator   User   @relation("CreatedBy", fields: [creatorId], references: [id])

  comments Comment[]

  @@index([companyId, status])
  @@index([assigneeId, status])
  @@index([companyId, priority])
  @@index([companyId, createdAt])
  @@index([departmentId])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("UserTaskAssignees", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@index([authorId])
}

model Shift {
  id           String   @id @default(cuid())
  name         String
  startTime    String   // e.g. "09:00"
  endTime      String   // e.g. "18:00"
  graceMinutes Int      @default(15)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, date])
  @@index([companyId])
}

model Attendance {
  id              String   @id @default(cuid())
  date            DateTime
  inTime          String?  // e.g. "09:25"
  outTime         String?  // e.g. "18:30"
  status          String   @default("PRESENT") // PRESENT, LATE, ABSENT, HOLIDAY, WEEKEND, LEAVE, HALF_DAY
  lateMinutes     Int      @default(0)
  latePenalty     Float    @default(0)
  overtimeMinutes Int      @default(0)
  workingMinutes  Int      @default(0)
  notes           String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([companyId, date])
  @@index([userId, status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  daysCount   Int       @default(1)
  leaveType   String    @default("CASUAL") // CASUAL, SICK, ANNUAL, EMERGENCY, UNPAID
  reason      String    @db.Text
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  
  actionToken String?   @unique
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reviewerId  String?
  reviewer    User?     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([userId, status])
  @@index([actionToken])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // TASK_CREATE, TASK_UPDATE, TASK_DELETE, LEAVE_APPLY, LEAVE_APPROVE, LEAVE_REJECT, LEAVE_CANCEL, CLOCK_IN, CLOCK_OUT, USER_CREATE, USER_UPDATE, etc.
  entityType  String   // TASK, LEAVE, ATTENDANCE, USER, DEPARTMENT, SHIFT, HOLIDAY, AUTH
  entityId    String?
  description String   @db.Text
  details     String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, entityType])
  @@index([userId, createdAt])
}

